# disk config
STORAGE_DIR=/home/me/databarn/data

# ClickHouse
CLICKHOUSE_VERSION=26.8.4
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=changeme
CLICKHOUSE_DB=default
# Host-published ports (container still listens on 8123/9000/9363).
CLICKHOUSE_HOST_HTTP_PORT=18123
CLICKHOUSE_HOST_NATIVE_PORT=19000
CLICKHOUSE_HOST_METRICS_PORT=19363
CLICKHOUSE_MAX_MEMORY_USAGE=10000000000
CLICKHOUSE_USE_UNCOMPRESSED_CACHE=1
CLICKHOUSE_MAX_THREADS=4
CLICKHOUSE_MAX_INSERT_THREADS=2
CLICKHOUSE_MAX_FINAL_THREADS=4
CLICKHOUSE_PARALLEL_VIEW_PROCESSING=1
CLICKHOUSE_USE_ASYNC_EXECUTOR_FOR_MATERIALIZED_VIEWS=1
CLICKHOUSE_MAX_BYTES_BEFORE_EXTERNAL_SORT=4294967296
CLICKHOUSE_MAX_BYTES_BEFORE_EXTERNAL_GROUP_BY=4294967296
CLICKHOUSE_MAX_CONNECTIONS=200
CLICKHOUSE_MAX_CONCURRENT_QUERIES=200
CLICKHOUSE_UNCOMPRESSED_CACHE_SIZE=4294967296
CLICKHOUSE_MARK_CACHE_SIZE=2147483648


# api
API_CLICKHOUSE_HOST=localhost
API_CLICKHOUSE_USER=api
API_CLICKHOUSE_PORT=18123
API_CLICKHOUSE_PASSWORD=changeme
API_CLICKHOUSE_DB=analytics
API_RATE_LIMIT_PER_MINUTE=100
API_CACHE_TTL_SECONDS=3600
API_HOST=127.0.0.1
API_PORT=8080

# dbt
DBT_RUN_LOCKFILE=dbt/.dbt_run.lock
DBT_RUN_LOCK_TIMEOUT=30
DBT_PRINTER_WIDTH=120
DBT_LOG_FORMAT=text
DBT_USE_COLORS=true
DBT_CLICKHOUSE_HOST=localhost
DBT_CLICKHOUSE_PORT=18123
DBT_CLICKHOUSE_USER=dbt
DBT_CLICKHOUSE_PASSWORD=changeme
DBT_CLICKHOUSE_STAGING_DB=dbt
DBT_CLICKHOUSE_DB=analytics
DBT_ENVIO_BALANCES_DB=envio
DBT_DOCS_WEBAPP_DOMAIN_NAME=docs.example.com

# Discord alerts (empty = disabled). Used by dbt and dlt schedulers.
DISCORD_WEBHOOK_URL=

# dlt
DLT_ENV=development
DLT_CLICKHOUSE_HOST=localhost
DLT_CLICKHOUSE_PORT=19000
DLT_CLICKHOUSE_HTTP_PORT=18123
DLT_CLICKHOUSE_USER=dlt
DLT_CLICKHOUSE_PASSWORD=changeme
DLT_CLICKHOUSE_DB=dlt
DLT_PIPELINE_ITERATION_TIMEOUT=30 # seconds

# PostgreSQL - beefy-db source (Heroku). harvests, zaps, and remaining lookups.
BEEFY_DB_HOST=postgres.example.com
BEEFY_DB_PORT=5432
BEEFY_DB_NAME=beefy-db
BEEFY_DB_USER=postgres
BEEFY_DB_PASSWORD=changeme
# Heroku/AWS Postgres requires TLS. Local docker postgres: disable
BEEFY_DB_SSLMODE=require

# PostgreSQL - beefy TimescaleDB on Tiger Cloud.
# Hypertables: prices, apys, tvls, tvl_by_chain. Lookups: chains, price_oracles, vault_ids.
# Port is often not 5432; copy it from the Tiger Cloud connection string.
BEEFY_TIMESCALEDB_HOST=service.project.tsdb.cloud.timescale.com
BEEFY_TIMESCALEDB_PORT=5432
BEEFY_TIMESCALEDB_NAME=tsdb
BEEFY_TIMESCALEDB_USER=tsdbadmin
BEEFY_TIMESCALEDB_PASSWORD=changeme
BEEFY_TIMESCALEDB_SSLMODE=require

# RustFS (S3-compatible object storage) — ClickHouse backups + beefy-history parquet
RUSTFS_ENDPOINT=http://localhost:9002
RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=changeme

# beefy-history CLI → parquet → RustFS (not a dlt source; never the backup bucket)
# Pinned SHA: see dlt/lib/beefy_history.py CLI_GIT_SHA and infra/dlt/Dockerfile
BEEFY_HISTORY_S3_BUCKET=beefy-history
BEEFY_HISTORY_S3_ENDPOINT=http://localhost:9002
BEEFY_HISTORY_S3_EVENTS_URL=http://rustfs:9000/beefy-history/current/events.parquet
BEEFY_HISTORY_S3_ISSUES_URL=http://rustfs:9000/beefy-history/current/issues.parquet
# Host-side producer only; the dlt image sets these.
# BEEFY_HISTORY_DIR=/path/to/beefy-history
# BEEFY_HISTORY_DATA_DIR=/home/me/databarn/data/beefy-history
# Keys default to CLICKHOUSE_BACKUP_S3_* / RUSTFS_*
# BEEFY_HISTORY_S3_ACCESS_KEY=admin
# BEEFY_HISTORY_S3_SECRET_KEY=changeme

# ClickHouse native BACKUP/RESTORE destination (RustFS now; swap endpoint/keys for remote S3 later)
CLICKHOUSE_BACKUP_S3_ENDPOINT=http://rustfs:9000
CLICKHOUSE_BACKUP_S3_BUCKET=clickhouse-backups
CLICKHOUSE_BACKUP_S3_DISK_ENDPOINT=http://rustfs:9000/clickhouse-backups/
CLICKHOUSE_BACKUP_S3_ACCESS_KEY=admin
CLICKHOUSE_BACKUP_S3_SECRET_KEY=changeme
# Each full is ~100GB; host fits ~3 including an in-progress full. Default keeps 2 completed fulls.
# CLICKHOUSE_BACKUP_KEEP_FULLS=2
# Hourly incrementals only for the newest N days (default 1 = today).
# CLICKHOUSE_BACKUP_KEEP_INCREMENTAL_DAYS=1
# Optional; defaults to CLICKHOUSE_PASSWORD
# CLICKHOUSE_BACKUP_PASSWORD=

# Traefik
TRAEFIK_LOG_LEVEL=INFO
TRAEFIK_DOCKER_NETWORK=beefy-databarn_frontend_network # as seen in `docker network ls`, not the compose shorthand
TRAEFIK_EMAIL=admin@example.com

# Postgres
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres
POSTGRES_ADMIN_DB=postgres

# Grafana
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_WEBAPP_DOMAIN_NAME=localhost:3000
GRAFANA_LOG_LEVEL=debug
GRAFANA_SECRET_KEY=changeme
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_POSTGRES_HOST=postgres
GRAFANA_POSTGRES_PORT=5432
GRAFANA_POSTGRES_USER=grafana
GRAFANA_POSTGRES_DB=grafana
GRAFANA_POSTGRES_PASSWORD=changeme
GRAFANA_CLICKHOUSE_USER=grafana
GRAFANA_CLICKHOUSE_HOST=clickhouse
GRAFANA_CLICKHOUSE_PORT=8123
GRAFANA_CLICKHOUSE_PASSWORD=changeme
GRAFANA_CLICKHOUSE_DB=analytics
GRAFANA_REDIS_CONNSTR=addr=redis:6379,pool_size=20,db=2,ssl=false
GRAFANA_REDIS_PREFIX=grafana:
# set callback url to https://${GRAFANA_WEBAPP_DOMAIN_NAME}/login/github
GRAFANA_GITHUB_CLIENT_ID=changeme
GRAFANA_GITHUB_CLIENT_SECRET=changeme
GRAFANA_GITHUB_ALLOWED_ORG=beefyfinance

# Superset
SUPERSET_ENV=development
SUPERSET_LOG_LEVEL=INFO
SUPERSET_POSTGRES_DB=superset
SUPERSET_POSTGRES_USER=superset
SUPERSET_POSTGRES_PASSWORD=changeme
SUPERSET_CLICKHOUSE_HOST=clickhouse
SUPERSET_CLICKHOUSE_PORT=8123
SUPERSET_CLICKHOUSE_USER=superset
SUPERSET_CLICKHOUSE_PASSWORD=changeme
SUPERSET_CLICKHOUSE_DB=analytics
SUPERSET_SECRET_KEY=changeme
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=changeme
SUPERSET_ADMIN_EMAIL=admin@admin.com
SUPERSET_REDIS_CELERY_DB=0
SUPERSET_REDIS_RESULTS_DB=1
SUPERSET_WEBAPP_DOMAIN_NAME=localhost:8088
# set github app redirect url as https://${SUPERSET_WEBAPP_DOMAIN_NAME}/oauth-authorized/github
SUPERSET_GITHUB_CLIENT_ID=changeme
SUPERSET_GITHUB_CLIENT_SECRET=changeme
SUPERSET_GITHUB_ALLOWED_ORG=beefyfinance
SUPERSET_AUTH_USER_REGISTRATION_ROLE=Gamma

# Prometheus
PROMETHEUS_ENVIRONMENT=dev

# envio (project ingest; same knobs as zapalytics, higher defaults so the indexer is not stalled)
ENVIO_CLICKHOUSE_USER=envio
ENVIO_CLICKHOUSE_PASSWORD=changeme
ENVIO_MAX_MEMORY_USAGE=4000000000
ENVIO_MAX_EXECUTION_TIME=120
ENVIO_MAX_INSERT_THREADS=4
ENVIO_MAX_INSERT_BLOCK_SIZE=65536
ENVIO_MAX_PARTITIONS_PER_INSERT_BLOCK=100
ENVIO_MAX_RESULT_ROWS=100000
ENVIO_MAX_ROWS_TO_READ=1000000
ENVIO_QUOTA_INSERTS_PER_SECOND=200
ENVIO_QUOTA_WRITTEN_BYTES_PER_SECOND=52428800
ENVIO_QUOTA_INSERTS_PER_HOUR=500000
ENVIO_QUOTA_WRITTEN_BYTES_PER_HOUR=10737418240
ENVIO_QUOTA_WRITTEN_BYTES_PER_DAY=107374182400

# zapalytics (INSERT/CREATE TABLE only)
ZAPALYTICS_CLICKHOUSE_USER=zapalytics
ZAPALYTICS_CLICKHOUSE_PASSWORD=changeme
ZAPALYTICS_MAX_MEMORY_USAGE=1000000000
ZAPALYTICS_MAX_EXECUTION_TIME=30
ZAPALYTICS_MAX_INSERT_THREADS=1
ZAPALYTICS_MAX_INSERT_BLOCK_SIZE=8192
ZAPALYTICS_MAX_PARTITIONS_PER_INSERT_BLOCK=10
ZAPALYTICS_MAX_RESULT_ROWS=100000
ZAPALYTICS_MAX_ROWS_TO_READ=1000000
ZAPALYTICS_QUOTA_INSERTS_PER_SECOND=5
ZAPALYTICS_QUOTA_WRITTEN_BYTES_PER_SECOND=5242880
ZAPALYTICS_QUOTA_INSERTS_PER_HOUR=500
ZAPALYTICS_QUOTA_WRITTEN_BYTES_PER_HOUR=104857600
ZAPALYTICS_QUOTA_WRITTEN_BYTES_PER_DAY=1073741824
